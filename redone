// Special Offer Popup - Appears after scrolling
const SpecialOfferPopup = () => {
  const [isVisible, setIsVisible] = useState(false);
  const [hasShown, setHasShown] = useState(false);

  useEffect(() => {
    const handleScroll = () => {
      if (!hasShown && window.scrollY > 1200) {
        setIsVisible(true);
        setHasShown(true);
      }
    };

    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, [hasShown]);

  if (!isVisible) return null;

  return (
    <AnimatePresence>
      <motion.div
        initial={{ opacity: 0, scale: 0.8, y: 100 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.8 }}
        className="fixed bottom-8 right-8 z-50 max-w-md"
      >
        <Card className="border-2 border-primary shadow-2xl overflow-hidden">
          <div className="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-primary/20 to-transparent rounded-full blur-2xl" />
          <CardContent className="p-6 relative">
            <button
              onClick={() => setIsVisible(false)}
              className="absolute top-4 right-4 text-muted-foreground hover:text-foreground transition-colors z-10"
            >
              <X className="h-4 w-4" />
            </button>
            
            <div className="flex items-start gap-4 mb-4">
              <div className="w-14 h-14 bg-gradient-to-br from-primary to-chart-2 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
                <Gift className="h-7 w-7 text-white" />
              </div>
              <div>
                <Badge className="mb-2 bg-primary text-white">Limited Time Offer</Badge>
                <h3 className="font-bold text-xl mb-2">Get 20% Off Your First Project!</h3>
                <p className="text-sm text-muted-foreground leading-relaxed">
                  Book a free consultation this week and save $500+ on your automation system.
                </p>
              </div>
            </div>

            <div className="bg-muted/50 rounded-lg p-3 mb-4">
              <div className="flex items-center gap-2 text-sm">
                <Clock className="h-4 w-4 text-primary" />
                <span className="font-semibold">Offer expires in 3 days</span>
              </div>
            </div>

            <Button 
              className="w-full shadow-lg" 
              onClick={() => {
                document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
                setIsVisible(false);
              }}
            >
              Claim Your Discount
              <ArrowRight className="ml-2 h-4 w-4" />
            </Button>
          </CardContent>
        </Card>
      </motion.div>
    </AnimatePresence>
  );
};

